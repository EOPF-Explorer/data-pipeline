.git
.github
tests/
notebooks/
# operator-tools/ is excluded except the two modules the purge CLI needs, so a
# bulk delete can run as an in-cluster workflow without shipping the notebooks,
# codecs, migration helpers and local tooling that live alongside them.
operator-tools/*
!operator-tools/manage_collections.py
!operator-tools/manage_item.py
tasks/
*.ipynb
*.md
# README.md is re-included because the Dockerfile COPYs it explicitly
!README.md
.ruff_cache/
.mypy_cache/
.pytest_cache/
__pycache__/
*.pyc
.venv/
htmlcov/
